{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nmims2026",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-31",
  "observability": {
    "enabled": true
  },

  // ダッシュボードで設定したSecretをデプロイ時にも維持する。
  "keep_vars": true,

  // 静的ページは ./public。Workerは /api/* だけを処理し、
  // それ以外はassetsに流す。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // awec2026とは別のWorker・別のD1を使用する。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peereval",
      "database_id": "9e213d91-6d34-4094-ad20-955efc2f27ad"
    }
  ]

  // ダッシュボードで設定するSecret:
  // SESSION_SECRET
  // BOOTSTRAP_TOKEN
}
